{
  "name": "stasis-compat-bench-v1",
  "version": "1.0.0",
  "description": "Reviewer-owned compatibility evidence harness; @oxhq/stasis@0.2.1 is the sealed historical dependency, not the Stasis v0.3.3 candidate.",
  "private": true,
  "author": "David Garay <garaekz@gmail.com>",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "22.20.0"
  },
  "scripts": {
    "check": "node --test test/*.test.mjs",
    "rwa:baseline": "node src/rwa/run-cypress.mjs",
    "rwa:stasis": "node src/rwa/run-stasis.mjs",
    "rwa:compare": "node src/rwa/compare.mjs",
    "proof": "npm ci && node src/proof.mjs",
    "finalize": "node src/finalize.mjs",
    "crawl:baseline": "node src/crawl/run-playwright.mjs",
    "crawl:stasis": "node src/crawl/run-stasis.mjs",
    "crawl:compare": "node src/crawl/compare.mjs",
    "crawl:proof": "node src/crawl/proof.mjs",
    "census:deterministic:baseline": "node src/crawl-v03/run-playwright.mjs",
    "census:deterministic:stasis": "node src/crawl-v03/run-stasis.mjs",
    "census:deterministic:compare": "node src/crawl-v03/compare.mjs",
    "census:deterministic:proof": "node src/crawl-v03/proof.mjs",
    "wild:select": "node src/wild/run-preflight.mjs",
    "wild:policy-smoke": "node src/wild/run-network-policy-smoke.mjs",
    "wild:paired": "node src/wild/run-paired.mjs",
    "wild:decision": "node src/wild/run-decision.mjs",
    "cookie:repro:local": "node src/minimizers/run-cookie-profile.mjs local",
    "cookie:repro:wild": "node src/minimizers/run-cookie-profile.mjs wild",
    "test:cookie-repro": "node --test test/cookie-profile-reproductions.test.mjs",
    "post-support:candidate": "node src/post-support/run.mjs candidate",
    "post-support:cookies": "node src/post-support/run.mjs cookies",
    "post-support:typed-minimizers": "node src/post-support/run.mjs typed-minimizers",
    "post-support:deterministic": "node src/post-support/run.mjs deterministic",
    "post-support:rwa": "node src/post-support/run.mjs rwa",
    "post-support:wild:smoke": "node src/post-support/run.mjs wild-smoke",
    "post-support:wild:paired": "node src/post-support/run.mjs wild-paired",
    "post-support:wild:verify:diagnostic": "node src/post-support/run.mjs wild-verify",
    "post-support:wild": "node src/post-support/run.mjs wild",
    "publication:extract-wild-authority": "node src/publication/cli.mjs extract-wild-authority",
    "publication:project-rwa-baseline": "node src/publication/cli.mjs project-rwa-baseline",
    "publication:plan": "node src/publication/cli.mjs plan",
    "publication:projection": "node src/publication/cli.mjs projection",
    "publication:projection:update": "node src/publication/update-public-projection.mjs",
    "publication:build": "node src/publication/cli.mjs build",
    "publication:verify": "node src/publication/cli.mjs verify",
    "publication:archive": "node src/publication/cli.mjs archive",
    "publication:archive:verify": "node src/publication/cli.mjs archive-verify"
  },
  "dependencies": {
    "@oxhq/stasis": "0.2.1",
    "crawlee": "3.18.1",
    "playwright": "1.62.1"
  }
}
